# Copy to .env.local and fill in, or run `npm run dev` and use the /setup wizard.
# Every variable is validated at startup by src/env.ts.

# Public URL of the site. Used for metadata, sitemap and OG images.
# Defaults to VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Clerk: https://dashboard.clerk.com > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk > Webhooks > your endpoint > Signing secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase: Project settings > API keys. For the local stack, `npm run db:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: Google Analytics 4. Only loaded after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: end-to-end tests against a configured app (see tests/e2e/auth.spec.ts).
# E2E_CLERK_USER_EMAIL=
# E2E_CLERK_USER_PASSWORD=
